# Imagen de los collectors (scheduler con todas las fuentes). Contexto de build: raíz del repo.
#   docker build -f infra/Dockerfile.collectors -t talaia-collectors .

FROM node:22-alpine AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH CI=1
RUN corepack enable
WORKDIR /app

# ---- build: instala todo el workspace y compila (los servicios comparten @talaia/shared, db…)
FROM base AS build
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY db/package.json db/
COPY collectors/open-meteo/package.json collectors/open-meteo/
COPY collectors/aemet/package.json collectors/aemet/
COPY collectors/saih/package.json collectors/saih/
COPY collectors/meteoalarm/package.json collectors/meteoalarm/
COPY collectors/avamet/package.json collectors/avamet/
COPY collectors/gva/package.json collectors/gva/
COPY collectors/scheduler/package.json collectors/scheduler/
COPY api/package.json api/
COPY web/package.json web/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile
COPY packages packages
COPY db db
COPY collectors collectors
COPY api api
COPY web web
RUN pnpm -r --workspace-concurrency=1 run build

# ---- runtime común
FROM node:22-alpine AS runtime
ENV NODE_ENV=production TZ=UTC
RUN apk add --no-cache tini && addgroup -S talaia && adduser -S talaia -G talaia
WORKDIR /app
USER talaia
ENTRYPOINT ["/sbin/tini", "--"]

# ---- poda: solo el scheduler y sus dependencias de producción (arrastra los collectors)
FROM build AS deploy
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm --filter @talaia/scheduler deploy --prod --legacy /out

FROM runtime AS collectors
COPY --from=deploy --chown=talaia:talaia /out /app
ENV HEARTBEAT_FILE=/tmp/talaia-heartbeat
HEALTHCHECK --interval=60s --timeout=5s --start-period=120s --retries=3 \
  CMD test -f /tmp/talaia-heartbeat && test $(( $(date +%s) - $(stat -c %Y /tmp/talaia-heartbeat) )) -lt 7200
CMD ["node", "dist/main.js"]

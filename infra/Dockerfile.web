# Imagen del frontend (Next.js standalone). Contexto de build: raíz del repo.
#   docker build -f infra/Dockerfile.web -t talaia-web .

FROM node:22-alpine AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH CI=1
RUN corepack enable
WORKDIR /app

# ---- build: instala todo el workspace y compila (los servicios comparten @talaia/shared, db…)
FROM base AS build
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY db/package.json db/
COPY collectors/open-meteo/package.json collectors/open-meteo/
COPY collectors/aemet/package.json collectors/aemet/
COPY collectors/saih/package.json collectors/saih/
COPY collectors/meteoalarm/package.json collectors/meteoalarm/
COPY collectors/avamet/package.json collectors/avamet/
COPY collectors/gva/package.json collectors/gva/
COPY collectors/scheduler/package.json collectors/scheduler/
COPY api/package.json api/
COPY web/package.json web/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile
COPY packages packages
COPY db db
COPY collectors collectors
COPY api api
COPY web web
RUN pnpm -r --workspace-concurrency=1 run build

# ---- runtime común
FROM node:22-alpine AS runtime
ENV NODE_ENV=production TZ=UTC
RUN apk add --no-cache tini && addgroup -S talaia && adduser -S talaia -G talaia
WORKDIR /app
USER talaia
ENTRYPOINT ["/sbin/tini", "--"]

# ---- build del frontend (Next.js en modo standalone)
FROM build AS build-web
RUN pnpm --filter @talaia/web run build

FROM runtime AS web
COPY --from=build-web --chown=talaia:talaia /app/web/.next/standalone /app
COPY --from=build-web --chown=talaia:talaia /app/web/.next/static /app/web/.next/static
# Next escribe su caché en ejecución: sin este directorio, el contenedor arranca pero
# registra errores de permisos en cada petición.
USER root
RUN mkdir -p /app/web/.next/cache && chown -R talaia:talaia /app/web/.next
USER talaia
ENV PORT=3001 HOSTNAME=0.0.0.0
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3001/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "web/server.js"]

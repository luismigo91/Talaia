# Copiar a .env y rellenar. Nunca subir .env al repo.

# Clave AEMET OpenData: https://opendata.aemet.es/centrodedescargas/altaUsuario
# En producción se define en la UI de Dokploy (Environment) con este mismo nombre.
AEMET_API_KEY=

# Postgres / TimescaleDB. Usuario y base fijos (talaia); solo la contraseña es configurable.
POSTGRES_PASSWORD=cambiame   # en producción: variable en la UI de Dokploy
# Para ejecutar collectors/api fuera de Docker contra la DB de tests:
# DATABASE_URL=postgres://talaia:talaia@localhost:5433/talaia

# Las localizaciones objetivo (Albal, Benetússer, Mareny de Barraquetes, Benaguasil) se definen
# como semillas en db/migrations (tabla stations), no aquí.

# SAIH Júcar (sin clave; endpoints internos de saih.chj.es)
# Intervalo del collector en minutos (registro cincominutal; 10 es de sobra) y horas de
# backfill la primera vez que se ve un sensor (máx. 168).
# SAIH_INTERVAL_MIN=10
# SAIH_BACKFILL_HOURS=24

# Semáforo de riesgo: minutos tras los que un dato observado deja de contar (las estaciones de
# embalse, que publican cada media hora, tienen un margen mayor). Los umbrales de lluvia están
# en la tabla `thresholds` (oficiales de AEMET), no aquí.
# RISK_STALE_MINUTES=30

# Observación de estaciones automáticas de AEMET (requiere clave). Lista de indicativos a
# vigilar; por defecto 8416, 8414A, 8337X, 8409X y 8328X (ver docs/fuentes.md).
# AEMET_OBSERVATION_STATIONS=8416,8414A,8337X
# AEMET_OBSERVATION_INTERVAL_MIN=30

# Meteoalarm (sin clave): republica los avisos de AEMET. Intervalo del collector en minutos.
# METEOALARM_INTERVAL_MIN=10

# AVAMET (estaciones amateur, sin clave). Comarca a leer y radio en km dentro del cual sus
# lecturas cuentan para el semáforo de una localidad.
# AVAMET_TERRITORY=c16
# AVAMET_INTERVAL_MIN=10
# AVAMET_RADIUS_KM=8

# Notificaciones del semáforo (opcionales): sin NTFY_URL solo se registra la transición.
# NTFY_URL=https://ntfy.sh/talaia-avisos
# NTFY_TOKEN=
# Cada cuántos minutos se evalúa el semáforo, y cuántas evaluaciones seguidas hacen falta para
# confirmar una BAJADA de nivel (las subidas se aplican siempre en el acto).
# RISK_INTERVAL_MIN=5
# RISK_FALL_CONFIRMATIONS=3

# API
API_PORT=3000

# Frontend (web). API_URL es interna: en compose/Dokploy, http://api:3000
# API_URL=http://localhost:3000
# API_REVALIDATE_SECONDS=60
# Estilo de mapa alternativo (por defecto, teselas de OpenStreetMap definidas en el código):
# NEXT_PUBLIC_MAP_STYLE=

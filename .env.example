# Copiar a .env y rellenar. Nunca subir .env al repo.

# Clave AEMET OpenData: https://opendata.aemet.es/centrodedescargas/altaUsuario
# En producción se define en la UI de Dokploy (Environment) con este mismo nombre.
AEMET_API_KEY=

# Postgres / TimescaleDB. Usuario y base fijos (talaia); solo la contraseña es configurable.
POSTGRES_PASSWORD=cambiame   # en producción: variable en la UI de Dokploy
# Para ejecutar collectors/api fuera de Docker contra la DB de tests:
# DATABASE_URL=postgres://talaia:talaia@localhost:5433/talaia

# Las localizaciones objetivo (Albal, Benetússer, Mareny de Barraquetes, Benaguasil) se definen
# como semillas en db/migrations (tabla stations), no aquí.

# SAIH Júcar (sin clave; endpoints internos de saih.chj.es)
# Intervalo del collector en minutos (registro cincominutal; 10 es de sobra) y horas de
# backfill la primera vez que se ve un sensor (máx. 168).
# SAIH_INTERVAL_MIN=10
# SAIH_BACKFILL_HOURS=24

# Semáforo de riesgo: minutos tras los que un dato observado deja de contar (las estaciones de
# embalse, que publican cada media hora, tienen un margen mayor). Los umbrales de lluvia están
# en la tabla `thresholds` (oficiales de AEMET), no aquí.
# RISK_STALE_MINUTES=30

# API
API_PORT=3000

# Copiar a .env y rellenar. Nunca subir .env al repo.

# Clave AEMET OpenData: https://opendata.aemet.es/centrodedescargas/altaUsuario
# En producción (Swarm) es un secret externo: `docker secret create aemet_api_key -`
# y el stack la monta en /run/secrets/aemet_api_key (AEMET_API_KEY_FILE).
# En desarrollo local basta con la variable:
AEMET_API_KEY=

# Postgres / TimescaleDB
POSTGRES_USER=talaia
POSTGRES_PASSWORD=cambiame   # en Swarm: secret externo postgres_password (POSTGRES_PASSWORD_FILE)
POSTGRES_DB=talaia
DATABASE_URL=postgres://talaia:cambiame@db:5432/talaia

# Las localizaciones objetivo (Albal, Benetússer, Mareny de Barraquetes, Benaguasil) se definen
# como semillas en db/migrations (tabla stations), no aquí.

# API
API_PORT=3000
